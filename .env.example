# =============================================================================
# Pursuit Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See docs/environment-variables.md for full documentation.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
# Controls which settings module is loaded.
# Options: pursuit_backend.settings.development (default for manage.py)
#          pursuit_backend.settings.staging
#          pursuit_backend.settings.production (default for wsgi/asgi)
DJANGO_SETTINGS_MODULE=pursuit_backend.settings.development

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# REQUIRED in production/staging.
SECRET_KEY=django-insecure-change-me-in-production

# Comma-separated. In development, defaults to allowing all hosts.
# REQUIRED in production/staging.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
DB_NAME=pursuit_db
DB_USER=pursuit_user
DB_PASSWORD=pursuit_password
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. Falls back to SECRET_KEY in development.
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------------------
# Redis / Cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1

# ---------------------------------------------------------------------------
# Celery (Task Queue)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# In development, emails are printed to console regardless of these values.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@pursuit.com

# ---------------------------------------------------------------------------
# Cloudinary (Image Storage)
# ---------------------------------------------------------------------------
# Optional in development (falls back to local FileSystemStorage).
# Required in staging/production for persistent image uploads.
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# OpenWeatherMap (Weather Data)
# ---------------------------------------------------------------------------
# Free tier: https://openweathermap.org/api — 1,000 calls/day
OPENWEATHERMAP_API_KEY=

# ---------------------------------------------------------------------------
# CORS (staging/production only)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins. Ignored in development (all allowed).
CORS_ALLOWED_ORIGINS=
